      "properties": {
        "expanded_bytes": {
          "minimum": 0,
          "type": "integer"
        },
        "header": {
          "additionalProperties": false,
          "properties": {
            "dds": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "caps": {
                      "items": {
                        "maximum": 4294967295,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "maxItems": 4,
                      "minItems": 4,
                      "type": "array"
                    },
                    "depth": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "flags": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "fourcc": {
                      "type": "string"
                    },
                    "masks": {
                      "items": {
                        "maximum": 4294967295,
                        "minimum": 0,
                        "type": "integer"
                      },
                      "maxItems": 4,
                      "minItems": 4,
                      "type": "array"
                    },
                    "pitch_or_linear_size": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "pixel_flags": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "rgb_bits": {
                      "maximum": 4294967295,
                      "minimum": 0,
                      "type": "integer"
                    }
                  },
                  "required": [
                    "flags",
                    "pitch_or_linear_size",
                    "depth",
                    "pixel_flags",
                    "fourcc",
                    "rgb_bits",
                    "masks",
                    "caps"
                  ],
                  "type": "object"
                },
                {
                  "type": "null"
                }
              ]
            },
            "flags": {
              "anyOf": [
                {
                  "maximum": 4294967295,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "format_raw": {
              "anyOf": [
                {
                  "maximum": 4294967295,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "minimum": 1,
              "type": "integer"
            },
            "mips": {
              "minimum": 0,
              "type": "integer"
            },
            "no_srgb": {
              "type": "boolean"
            },
            "pixel_format": {
              "enum": [
                "BC1",
                "BC3",
                "BGRA8"
              ]
            },
            "remap": {
              "anyOf": [
                {
                  "maximum": 4294967295,
                  "minimum": 0,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "width": {
              "minimum": 1,
              "type": "integer"
            },
            "wrapper": {
              "enum": [
                "GTF",
                "TEX/DDS"
              ]
