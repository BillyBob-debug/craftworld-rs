  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Private cached texture metadata only. Pixels and encoded asset bytes are excluded.",
  "properties": {
    "last_request": {
      "additionalProperties": false,
      "properties": {
        "error_kind": {
          "$ref": "#/$defs/error"
        },
        "outcome": {
          "enum": [
            "complete",
            "partial",
            "failed"
          ]
        }
      },
      "required": [
        "outcome",
        "error_kind"
      ],
      "type": "object"
    },
    "location": {
      "additionalProperties": false,
      "properties": {
        "offset": {
          "minimum": 0,
          "type": "integer"
        },
        "size": {
          "minimum": 0,
          "type": "integer"
        },
        "source_path": {
          "description": "Normalized source-relative path; the writer additionally rejects traversal, colon and backslash.",
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source_path",
        "offset",
        "size"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": 1
    },
    "scope": {
      "const": "cached_texture_diagnostic_metadata_not_asset_export"
    },
    "source_state": {
      "const": "validated_at_read_not_rechecked_for_export"
    },
    "stages": {
      "additionalProperties": false,
      "properties": {
        "texture": {
          "allOf": [
            {
              "$ref": "#/$defs/stage"
            },
            {
              "properties": {
                "metadata": {
                  "anyOf": [
                    {
                      "$ref": "#/$defs/textureMetadata"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          ]
        }
      },
      "required": [
        "texture"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "scope",
    "source_state",
    "location",
    "last_request",
    "stages"
  ],
  "title": "Cached texture diagnostic envelope version 1",
  "type": "object"
}
