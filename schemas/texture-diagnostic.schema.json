{
  "$defs": {
    "error": {
      "enum": [
        null,
        "cancelled",
        "blocked_protected",
        "unsupported_layout",
        "budget_exceeded",
        "source_changed",
        "inspection_failed"
      ]
    },
    "stage": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {
            "properties": {
              "metadata": {
                "type": "null"
              }
            }
          },
          "if": {
            "properties": {
              "status": {
                "const": "available"
              }
            }
          },
          "then": {
            "properties": {
              "metadata": {
                "type": "object"
              }
            }
          }
        }
      ],
      "properties": {
        "error_kind": {
          "$ref": "#/$defs/error"
        },
        "metadata": {
          "type": [
            "object",
            "null"
          ]
        },
        "requested_in_current_mode": {
          "type": "boolean"
        },
        "status": {
          "enum": [
            "available",
            "failed",
            "blocked",
            "unsupported",
            "cancelled",
            "not_available",
            "not_requested"
          ]
        }
      },
      "required": [
        "status",
        "requested_in_current_mode",
        "error_kind",
        "metadata"
      ],
      "type": "object"
    },
    "textureMetadata": {
